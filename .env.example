# Copy to .env for local development. Never commit real values.

# Agri-Buddy AI assistant (Google Gemini). On Netlify, AI Gateway can supply this automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Smart Weather Dashboard (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Reserved from the original spec. Persistence is planned on Netlify Database (managed Postgres,
# provisioned automatically), so this is not required — see PLAN.md, milestone 2.
MONGODB_URL=your_mongodb_connection_string_here
